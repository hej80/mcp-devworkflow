# ---------------------------------------------------------------------------
# devworkflow MCP server -- example configuration.
#
# Copy this file to `.env` in the same directory and fill in your own values:
#     cp .env.example .env
#
# `.env` is listed in .gitignore and must NEVER be committed.
# This file (.env.example) is committed, and contains no real secrets.
# ---------------------------------------------------------------------------

# --- REQUIRED: GitHub authentication ---------------------------------------
# Create a *fine-grained* Personal Access Token at:
#   https://github.com/settings/personal-access-tokens/new
# Repository access : only the repo(s) you want this server to touch
# Permissions       : Issues -> Read and write
#                     Metadata -> Read-only (added automatically)
GITHUB_TOKEN=github_pat_replace_me

# --- REQUIRED: filesystem sandbox ------------------------------------------
# The ONLY directory tree the git tools may read. Any repo_path that resolves
# outside this root is refused (see devworkflow/security.py).
WORKSPACE_ROOT=/Users/hamdanjaarour/mcp-workspace

# --- OPTIONAL: restrict which repositories may be written to ---------------
# Comma-separated "owner/repo" list. Leave blank for no allow-list.
ALLOWED_REPOS=

# --- Rate limiting (best practice #2) --------------------------------------
# Token bucket: WRITE_RATE_CAPACITY calls may burst, then refill at
# capacity/window per second. The small window below keeps the classroom demo
# short; 3 per 300s is a saner production value for a write tool.
WRITE_RATE_CAPACITY=3
WRITE_RATE_WINDOW_SECONDS=30
READ_RATE_CAPACITY=10
READ_RATE_WINDOW_SECONDS=60

# --- Safety limits ---------------------------------------------------------
GIT_TIMEOUT_SECONDS=10
HTTP_TIMEOUT_SECONDS=15
MAX_OUTPUT_CHARS=20000

# --- Advanced --------------------------------------------------------------
# Change only for GitHub Enterprise.
GITHUB_API_BASE=https://api.github.com
